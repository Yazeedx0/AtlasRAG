# ---------- app ----------
ATLAS_ENV=local                     # local | ci | prod
ATLAS_LOG_LEVEL=INFO
ATLAS_API_HOST=0.0.0.0
ATLAS_API_PORT=8000

# ---------- postgres + pgvector ----------
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
ATLAS_DATABASE_POOL_SIZE=10

# ---------- redis (semantic cache, exact cache, rate limit, queue) ----------
ATLAS_REDIS_URL=redis://localhost:6379/0
ATLAS_SEMANTIC_CACHE_THRESHOLD=0.95
ATLAS_CACHE_TTL_SECONDS=86400

# ---------- security ----------
ATLAS_JWT_SECRET=change-me
ATLAS_JWT_ALGORITHM=HS256
ATLAS_ACCESS_TOKEN_TTL_MINUTES=30
ATLAS_REFRESH_TOKEN_TTL_DAYS=14

# ---------- models (via LiteLLM) ----------
ATLAS_LLM_STRONG_MODEL=claude-sonnet-5
ATLAS_LLM_CHEAP_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# ---------- embeddings & reranking ----------
ATLAS_EMBEDDING_MODEL=text-embedding-3-large
ATLAS_EMBEDDING_DIMENSIONS=3072
ATLAS_RERANK_MODEL=rerank-v3.5
ATLAS_RERANK_TOP_N=6
ATLAS_RETRIEVAL_CANDIDATES=30

# ---------- observability ----------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
