# --------------- APP CONFIG --------------------
ATLAS_APP_NAME=AtlasRAG
ATLAS_ENVIRONMENT=development
ATLAS_DEBUG=false
# --------------- POSTGRSQL Config ----------------
ATLAS_POSTGRES_DB=atlasrag
ATLAS_POSTGRES_USER=atlas
ATLAS_POSTGRES_PASSWORD=atlas_dev_password
ATLAS_POSTGRES_PORT=5432
# --------------- KEYCLOAK Config ----------------
ATLAS_KEYCLOAK_DB=keycloak
ATLAS_KEYCLOAK_DB_USER=keycloak
ATLAS_KEYCLOAK_DB_PASSWORD=keycloak_dev_password
ATLAS_KEYCLOAK_PORT=8080
ATLAS_KEYCLOAK_ADMIN_USERNAME=admin
ATLAS_KEYCLOAK_ADMIN_PASSWORD=admin
ATLAS_KEYCLOAK_WEB_CLIENT_SECRET=atlasrag_web_dev_secret
ATLAS_SEED_USER_USERNAME=atlas-admin
ATLAS_SEED_USER_PASSWORD=
ATLAS_SEED_USER_EMAIL=atlas-admin@atlasrag.local
ATLAS_SEED_USER_DISPLAY_NAME=Atlas Admin
ATLAS_SEED_USER_FIRST_NAME=Atlas
ATLAS_SEED_USER_LAST_NAME=Admin
ATLAS_KEYCLOAK_ISSUER=http://localhost:8080/realms/atlasrag
ATLAS_KEYCLOAK_DISCOVERY_URL=http://localhost:8080/realms/atlasrag/.well-known/openid-configuration
ATLAS_KEYCLOAK_AUDIENCE=atlasrag-api
ATLAS_KEYCLOAK_ALGORITHMS=["RS256"]
ATLAS_KEYCLOAK_TIMEOUT_SECONDS=5
ATLAS_KEYCLOAK_JWKS_CACHE_TTL_SECONDS=3600
ATLAS_KEYCLOAK_JWKS_REFRESH_COOLDOWN_SECONDS=30
ATLAS_IDENTITY_JIT_ENABLED=true
# --------------- MINIO Config ----------------
ATLAS_MINIO_ROOT_USER=atlas
ATLAS_MINIO_ROOT_PASSWORD=atlas_dev_password
ATLAS_MINIO_PORT=9000
ATLAS_MINIO_CONSOLE_PORT=9001
ATLAS_MINIO_BUCKET=atlasrag
ATLAS_MINIO_ENDPOINT_URL=http://localhost:9000
ATLAS_MINIO_USE_SSL=false
