# --------------- APP CONFIG --------------------
ATLAS_APP_NAME=AtlasRAG
ATLAS_ENVIRONMENT=development
ATLAS_DEBUG=false
ATLAS_DISABLE_AUTH=false
# --------------- POSTGRSQL Config ----------------
ATLAS_POSTGRES_DB=atlasrag
ATLAS_POSTGRES_USER=atlas
ATLAS_POSTGRES_PASSWORD=atlas_dev_password
ATLAS_POSTGRES_PORT=5432
# --------------- KEYCLOAK Config ----------------
ATLAS_KEYCLOAK_DB=keycloak
ATLAS_KEYCLOAK_DB_USER=keycloak
ATLAS_KEYCLOAK_DB_PASSWORD=keycloak_dev_password
ATLAS_KEYCLOAK_PORT=8080
ATLAS_KEYCLOAK_ADMIN_USERNAME=admin
ATLAS_KEYCLOAK_ADMIN_PASSWORD=admin
ATLAS_KEYCLOAK_WEB_CLIENT_SECRET=atlasrag_web_dev_secret
ATLAS_SEED_USER_USERNAME=atlas-admin
ATLAS_SEED_USER_PASSWORD=
ATLAS_SEED_USER_EMAIL=atlas-admin@atlasrag.local
ATLAS_SEED_USER_DISPLAY_NAME=Atlas Admin
ATLAS_SEED_USER_FIRST_NAME=Atlas
ATLAS_SEED_USER_LAST_NAME=Admin
ATLAS_KEYCLOAK_ISSUER=http://localhost:8080/realms/atlasrag
ATLAS_KEYCLOAK_DISCOVERY_URL=http://localhost:8080/realms/atlasrag/.well-known/openid-configuration
ATLAS_KEYCLOAK_AUDIENCE=atlasrag-api
ATLAS_KEYCLOAK_ALGORITHMS=["RS256"]
ATLAS_KEYCLOAK_TIMEOUT_SECONDS=5
ATLAS_KEYCLOAK_JWKS_CACHE_TTL_SECONDS=3600
ATLAS_KEYCLOAK_JWKS_REFRESH_COOLDOWN_SECONDS=30
ATLAS_IDENTITY_JIT_ENABLED=true
# --------------- MINIO Config ----------------
ATLAS_MINIO_ROOT_USER=atlas
ATLAS_MINIO_ROOT_PASSWORD=atlas_dev_password
ATLAS_MINIO_PORT=9000
ATLAS_MINIO_CONSOLE_PORT=9001
ATLAS_MINIO_BUCKET=atlasrag
ATLAS_MINIO_ENDPOINT_URL=http://localhost:9000
ATLAS_MINIO_USE_SSL=false

# --------------- STORAGE Config -------------------
ATLAS_MINIO_ENDPOINT_URL = http://localhost:9000
ATLAS_MINIO_ACCESS_KEY = atlas
ATLAS_MINIO_SECRET_KEY = atlas_dev_password
ATLAS_MINIO_BUCKET = atlasrag
ATLAS_MINIO_REGION = us-east-1

# --------------- REDIS Config ----------------
ATLAS_REDIS_PASSWORD=atlas_dev_password
ATLAS_REDIS_PORT=6379

# --------------- CELERY FLOWER Config ----------------
ATLAS_FLOWER_PORT=5555
ATLAS_FLOWER_BASIC_AUTH=atlas:atlas_dev_password

# --------------- CELERY Config ----------------
ATLAS_CELERY_BROKER_URL=redis://:atlas_dev_password@localhost:6379/0
ATLAS_OUTBOX_PUBLISH_BATCH_SIZE=100
ATLAS_OUTBOX_PUBLISH_LEASE_SECONDS=60

# --------------- AI CAPABILITY Config -------------------
# provider: openai | anthropic | cohere | gemini
ATLAS_GENERATION_PROVIDER=openai
ATLAS_GENERATION_MODEL=gpt-4o-mini
ATLAS_EMBEDDING_PROVIDER=openai
ATLAS_EMBEDDING_MODEL=text-embedding-3-small
ATLAS_RERANK_PROVIDER=cohere
ATLAS_RERANK_MODEL=rerank-v3.5

# --------------- AI PROVIDER Credentials -------------------
ATLAS_OPENAI_API_KEY=
ATLAS_OPENAI_TIMEOUT_SECONDS=30
ATLAS_OPENAI_MAX_RETRIES=2
ATLAS_ANTHROPIC_API_KEY=
ATLAS_ANTHROPIC_TIMEOUT_SECONDS=30
ATLAS_ANTHROPIC_MAX_RETRIES=2
ATLAS_COHERE_API_KEY=
ATLAS_COHERE_TIMEOUT_SECONDS=30
ATLAS_COHERE_MAX_RETRIES=2
ATLAS_GEMINI_API_KEY=
ATLAS_GEMINI_TIMEOUT_SECONDS=30
ATLAS_GEMINI_MAX_RETRIES=2

# --------------- DOCUMENT ARTIFACT Config -------------------
ATLAS_ALLOWED_CONTENT_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/html","text/markdown","text/plain"]
ATLAS_ACCEPTED_LANGUAGE_CODES=["ar","en"]
ATLAS_ARTIFACT_KEY_MAX_LENGTH=255
ATLAS_LANGUAGE_CODE_MAX_LENGTH=20
ATLAS_MAX_FILE_SIZE_BYTES=52428800
ATLAS_STORAGE_PROVIDER=s3
