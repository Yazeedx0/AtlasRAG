meta {
  name: Get Current User
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/auth/me
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200 && res.body.principal_id) {
    bru.setEnvVar("currentPrincipalId", res.body.principal_id);
  }
}

tests {
  test("returns the authenticated principal", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.principal_id).to.be.a("string");
  });
}

docs {
  Verifies the Bearer token, resolves the external identity to a local principal, and captures
  `currentPrincipalId`.
}
