meta {
  name: List Permission Definitions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/iam/permissions
  body: none
  auth: inherit
}

tests {
  test("lists registered capability definitions", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  Requires `iam.permissions.manage`. Use a returned `permission_key` for grant and revoke paths.
}
