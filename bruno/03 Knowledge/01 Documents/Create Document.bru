meta {
  name: Create Document
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/documents
  body: json
  auth: inherit
}

body:json {
  {
    "canonical_key": "{{canonicalKey}}",
    "title": "Bruno Example Document",
    "description": "Document created from the AtlasRAG Bruno collection.",
    "document_type": "guide",
    "department": "engineering",
    "default_language_code": "en",
    "metadata": {
      "source": "bruno"
    }
  }
}

script:post-response {
  if (res.getStatus() === 201 && res.body.id) {
    bru.setEnvVar("documentId", res.body.id);
  }
}

tests {
  test("creates and captures a document", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.id).to.be.a("string");
    expect(res.body.canonical_key).to.equal(bru.getEnvVar("canonicalKey"));
  });
}

docs {
  Requires `knowledge.documents.manage`. Captures the generated ID as `documentId`. Change
  `canonicalKey` before repeating this request because it must be unique.
}
