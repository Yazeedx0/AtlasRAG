meta {
  name: Create Document Version
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/documents/{{documentId}}/versions
  body: json
  auth: inherit
}

body:json {
  {
    "version_label": "{{versionLabel}}",
    "metadata": {
      "source": "bruno"
    }
  }
}

script:post-response {
  if (res.getStatus() === 201 && res.body.id) {
    bru.setEnvVar("versionId", res.body.id);
  }
}

tests {
  test("creates and captures a draft version", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.status).to.equal("draft");
    expect(res.body.id).to.be.a("string");
  });
}

docs {
  Requires `knowledge.documents.manage`. Captures the generated draft version ID as `versionId`.
}
