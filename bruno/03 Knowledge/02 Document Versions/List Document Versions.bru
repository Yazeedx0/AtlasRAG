meta {
  name: List Document Versions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/documents/{{documentId}}/versions
  body: none
  auth: inherit
}

tests {
  test("lists all versions for the document", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  Requires `knowledge.documents.manage` and returns all versions for `documentId`.
}
