meta {
  name: Upload Document Artifact
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/documents/{{documentId}}/versions/{{versionId}}/artifacts
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  artifact_key: {{artifactKey}}
  language_code: {{languageCode}}
  file: @file(../../../fixtures/sample-artifact.txt)
  ~source_uri: {{sourceUri}}
  ~source_updated_at: {{sourceUpdatedAt}}
}

script:post-response {
  if (res.getStatus() === 201 && res.body.artifact_id) {
    bru.setEnvVar("artifactId", res.body.artifact_id);
  }
}

tests {
  test("uploads and captures the document artifact", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.artifact_id).to.be.a("string");
    expect(res.body.document_version_id).to.equal(bru.getEnvVar("versionId"));
  });
}

docs {
  Requires `knowledge.documents.manage` and a draft version. The included fixture is `text/plain`.
  Enable the optional source fields when needed. Allowed types and maximum size come from server
  configuration.
}
