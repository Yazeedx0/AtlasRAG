meta {
  name: Get Effective Document Version
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/documents/{{documentId}}/versions/effective
  body: none
  auth: inherit
}

params:query {
  ~at: {{effectiveAt}}
}

tests {
  test("returns the effective version or null", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body === null || typeof res.body === "object").to.equal(true);
  });
}

docs {
  Requires `knowledge.documents.manage`. With `at` disabled, the service evaluates the current
  time. Enable it to query the timezone-aware `effectiveAt` value.
}
