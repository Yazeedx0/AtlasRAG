meta {
  name: Publish Document Version
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/documents/{{documentId}}/versions/{{versionId}}/publish
  body: json
  auth: inherit
}

body:json {
  {
    "effective_from": "{{publishAt}}"
  }
}

tests {
  test("publishes the draft version", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.status).to.equal("published");
  });
}

docs {
  Requires `knowledge.documents.manage`. `publishAt` must be an ISO 8601 datetime with a timezone
  offset.
}
