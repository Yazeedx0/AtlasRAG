meta {
  name: Grant Document ACL
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/documents/{{documentId}}/acl
  body: json
  auth: inherit
}

body:json {
  {
    "principal_id": "{{currentPrincipalId}}",
    "permission": "{{aclPermission}}",
    "expires_at": "{{aclExpiresAt}}"
  }
}

script:post-response {
  if (res.getStatus() === 201 && res.body.grant_id) {
    bru.setEnvVar("grantId", res.body.grant_id);
  }
}

tests {
  test("creates and captures a document ACL grant", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.grant_id).to.be.a("string");
    expect(res.body.permission).to.equal(bru.getEnvVar("aclPermission"));
  });
}

docs {
  Requires `knowledge.document_acl.manage`. Grants `read` or `manage` access to the authenticated
  principal captured by `Get Current User`. `aclExpiresAt` must be timezone-aware and in the future.
}
