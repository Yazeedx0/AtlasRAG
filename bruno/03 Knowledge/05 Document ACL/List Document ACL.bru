meta {
  name: List Document ACL
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/documents/{{documentId}}/acl
  body: none
  auth: inherit
}

params:query {
  include_history: {{includeHistory}}
}

tests {
  test("lists document ACL grants", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  Requires `knowledge.document_acl.manage`. Set `includeHistory` to `true` to include expired and
  revoked grants.
}
